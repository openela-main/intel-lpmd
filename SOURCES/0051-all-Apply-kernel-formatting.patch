+	grp.worst_stall_cpu = min_s0_cpu;
+
+	grp.c0_max = max_load;
+	grp.c0_2nd_max = max_2nd_load;
+	grp.c0_3rd_max = max_3rd_load;
+	grp.c0_min = min_load;
+
+	return maxed_cpu;
