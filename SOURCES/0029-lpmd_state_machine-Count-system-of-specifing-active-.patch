 src/lpmd_cpu.c             | 14 +++++++---
 src/lpmd_cpumask.c         | 35 +++++++++++++++++++++++++
 src/lpmd_state_machine.c   | 52 +++++++++++++++++++++++++++++++++++---
 src/wlt_proxy/state_util.c |  6 -----
 5 files changed, 109 insertions(+), 13 deletions(-)

