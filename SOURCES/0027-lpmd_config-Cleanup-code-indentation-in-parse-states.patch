+			state->exit_gfx_load_thres = strtol (tmp_value, &pos, 10);
+		if (!strncmp((const char*)cur_node->name, "MinPollInterval", strlen("MinPollInterval")))
+			state->min_poll_interval = strtol (tmp_value, &pos, 10);
